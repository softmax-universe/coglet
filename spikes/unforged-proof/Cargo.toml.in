# Template, not a manifest. `run.sh` substitutes the @...@ placeholders and
# writes the real Cargo.toml into a disposable build directory, so the coglet
# tree never carries a tracked spike Cargo.toml/Cargo.lock (dependency-mirror
# input keys stay unchanged) and no CI job ever tries to fetch the private
# unforged repository.
[package]
name = "coglet-unforged-proof"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[lib]
path = "@SPIKE_DIR@/src/lib.rs"

[[bin]]
name = "coglet-unforged-proof"
path = "@SPIKE_DIR@/src/main.rs"

[[bin]]
name = "coglet-wamr-step"
path = "@SPIKE_DIR@/src/bin/coglet_wamr_step.rs"

[dependencies]
coglet-fs = { path = "@COGLET_DIR@/crates/coglet-fs" }
coglet-runtime = { path = "@COGLET_DIR@/crates/coglet-runtime", default-features = false, features = ["native-engine"] }
coglet-cli = { path = "@COGLET_DIR@/crates/coglet-cli" }
coglet-types-hub0 = { path = "@COGLET_DIR@/crates/coglet-types-hub0" }
coglet-engine-wamr = { path = "@COGLET_DIR@/crates/coglet-engine-wamr" }
gecaos = { path = "@UNFORGED_DIR@" }
unforged-gitobj = { path = "@UNFORGED_DIR@/crates/unforged-gitobj" }
iroh = { version = "=1.5.0", default-features = false, features = ["tls-ring"] }
russh = { version = "0.65.4", default-features = false, features = ["ring", "flate2", "rsa"] }
serde_json = "1"
hex = "0.4"

[profile.dev]
debug = 0
incremental = false
opt-level = 1

# Hashing a 1.3 MB guest per step is slow unoptimized; dependencies build optimized.
[profile.dev.package."*"]
opt-level = 3
