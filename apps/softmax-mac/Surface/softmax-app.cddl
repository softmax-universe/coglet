; Product-owned ADR-0030 contract. No imports, open maps, floats or regexes.
app-empty = {}
app-id = tstr .size (1..128)
app-cursor = tstr .size (1..128)
app-label = tstr .size (0..256)
app-text = tstr .size (0..4096)
app-revision = 0..18446744073709551615
app-window = "main" / "menu_bar" / "settings" / "onboarding" / "face" / "chat" / "orb" / "hud" / "command_palette" / "about" / "keyboard_shortcuts" / "hub_pairing" / "sign_out_confirmation" / "quit_confirmation"
app-settings-route = "general" / "hotkey" / "audio" / "hub" / "coglets" / "updates" / "privacy"
app-onboarding-route = "welcome" / "permissions" / "hub"
app-location = {window: "main", route: "main"} / {window: "menu_bar", route: "menu"} / {window: "settings", route: app-settings-route} / {window: "onboarding", route: app-onboarding-route} / {window: "face", route: "face"} / {window: "chat", route: "chat" / "voice"} / {window: "orb", route: "orb"} / {window: "hud", route: "hud"} / {window: "command_palette", route: "commands"} / {window: "about", route: "about"} / {window: "keyboard_shortcuts", route: "shortcuts"} / {window: "hub_pairing", route: "code" / "manual"} / {window: "sign_out_confirmation", route: "sign_out"} / {window: "quit_confirmation", route: "quit"}
app-appearance = "System" / "Light" / "Dark"
app-text-size = "standard" / "large" / "largest"
app-talk-mode = "hold" / "toggle"
app-hotkey = {key_code: 0..127, modifiers: [0*4 app-modifier]}
app-modifier = "command" / "control" / "option" / "shift"
app-login-status = "disabled" / "enabled" / "requiresApproval" / "unavailable" / "unknown"
app-settings = {appearance: app-appearance, text_size: app-text-size, floating_orb: bool, talk_mode: app-talk-mode, sound_cues: bool, hotkey: app-hotkey, launch_at_login: app-login-status}
app-setting-args = {key: "appearance", value: app-appearance} / {key: "text_size", value: app-text-size} / {key: "floating_orb", value: bool} / {key: "talk_mode", value: app-talk-mode} / {key: "sound_cues", value: bool} / {key: "hotkey", value: app-hotkey} / {key: "launch_at_login", value: bool}
app-selection = app-appearance / app-text-size / app-talk-mode / "chat" / "voice" / app-settings-route / app-onboarding-route
app-value = {kind: "none"} / {kind: "boolean", value: bool} / {kind: "integer", value: -9223372036854775808..9223372036854775807} / {kind: "text", value: app-text} / {kind: "selection", value: app-selection} / {kind: "redacted"}
app-role = "button" / "toggle" / "picker" / "text_field" / "secure_field" / "text_editor" / "slider" / "menu" / "menu_item" / "tab" / "disclosure" / "group" / "label" / "window" / "gesture"
app-control = {id: app-id, parent: app-id / null, window: app-window, role: app-role, label: app-label, value: app-value, enabled: bool, visible: bool, sensitive: bool}
app-settable-value = {kind: "boolean", value: bool} / {kind: "integer", value: -9223372036854775808..9223372036854775807} / {kind: "text", value: app-text} / {kind: "selection", value: app-selection}
app-invoke-args = {verb: "press", window: app-window, control: app-id} / {verb: "toggle", window: app-window, control: app-id, value: bool} / {verb: "select", window: app-window, control: app-id, value: app-selection} / {verb: "set_value", window: app-window, control: app-id, value: app-settable-value} / {verb: "type_text", window: app-window, control: app-id, value: app-text}
app-window-args = {window: app-window}
app-focus-args = {window: app-window, control: app-id}
app-controls-args = {window: app-window, after: null, limit: 1..128, revision: null} / {window: app-window, after: app-cursor, limit: 1..128, revision: app-revision}
app-controls-result = {revision: app-revision, window: app-window, controls: [0*128 app-control], next: app-cursor / null}
app-view-changed = {revision: app-revision, window: "main", route: "main"} / {revision: app-revision, window: "menu_bar", route: "menu"} / {revision: app-revision, window: "settings", route: app-settings-route} / {revision: app-revision, window: "onboarding", route: app-onboarding-route} / {revision: app-revision, window: "face", route: "face"} / {revision: app-revision, window: "chat", route: "chat" / "voice"} / {revision: app-revision, window: "orb", route: "orb"} / {revision: app-revision, window: "hud", route: "hud"} / {revision: app-revision, window: "command_palette", route: "commands"} / {revision: app-revision, window: "about", route: "about"} / {revision: app-revision, window: "keyboard_shortcuts", route: "shortcuts"} / {revision: app-revision, window: "hub_pairing", route: "code" / "manual"} / {revision: app-revision, window: "sign_out_confirmation", route: "sign_out"} / {revision: app-revision, window: "quit_confirmation", route: "quit"}
app-focus-changed = {revision: app-revision, window: app-window, control: app-id / null}
app-control-changed = {revision: app-revision, window: app-window, control: app-id, value: app-value}
app-window-changed = {revision: app-revision, open: true, window: "main", route: "main"} / {revision: app-revision, open: true, window: "menu_bar", route: "menu"} / {revision: app-revision, open: true, window: "settings", route: app-settings-route} / {revision: app-revision, open: true, window: "onboarding", route: app-onboarding-route} / {revision: app-revision, open: true, window: "face", route: "face"} / {revision: app-revision, open: true, window: "chat", route: "chat" / "voice"} / {revision: app-revision, open: true, window: "orb", route: "orb"} / {revision: app-revision, open: true, window: "hud", route: "hud"} / {revision: app-revision, open: true, window: "command_palette", route: "commands"} / {revision: app-revision, open: true, window: "about", route: "about"} / {revision: app-revision, open: true, window: "keyboard_shortcuts", route: "shortcuts"} / {revision: app-revision, open: true, window: "hub_pairing", route: "code" / "manual"} / {revision: app-revision, open: true, window: "sign_out_confirmation", route: "sign_out"} / {revision: app-revision, open: true, window: "quit_confirmation", route: "quit"} / {revision: app-revision, window: app-window, open: false, route: null}
app-window-state = {open: true, window: "main", route: "main"} / {open: true, window: "menu_bar", route: "menu"} / {open: true, window: "settings", route: app-settings-route} / {open: true, window: "onboarding", route: app-onboarding-route} / {open: true, window: "face", route: "face"} / {open: true, window: "chat", route: "chat" / "voice"} / {open: true, window: "orb", route: "orb"} / {open: true, window: "hud", route: "hud"} / {open: true, window: "command_palette", route: "commands"} / {open: true, window: "about", route: "about"} / {open: true, window: "keyboard_shortcuts", route: "shortcuts"} / {open: true, window: "hub_pairing", route: "code" / "manual"} / {open: true, window: "sign_out_confirmation", route: "sign_out"} / {open: true, window: "quit_confirmation", route: "quit"} / {open: false, window: app-window, route: null}
app-talk-state = "onboarding" / "offline" / "idle" / "listening" / "thinking" / "speaking" / "error"
app-hud-state = "idle" / "listening" / "thinking" / "speaking" / "cancelled" / "microphone-denied" / "offline" / "error"
app-ptt = {state: app-talk-state, visible: bool, elapsed_ms: 0..120000, level: 0..1000}
app-hud = {state: app-hud-state, visible: bool, elapsed_ms: 0..120000, level: 0..1000}
app-face = {visible: bool, mode: "full" / "compact", expression: "neutral" / "listening" / "thinking" / "speaking" / "happy" / "concerned", status: "idle" / "listening" / "thinking" / "speaking"}
app-state-result = {revision: app-revision, windows: [0*64 app-window-state], focus: {window: app-window, control: app-id} / null, settings: app-settings, ptt: app-ptt, hud: app-hud, hub: "offline" / "connecting" / "connected", face: app-face}
