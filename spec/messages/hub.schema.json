{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coglet.dev/spec/messages/hub.schema.json",
  "$ref": "#/$defs/hub-frame",
  "$defs": {
    "hub-null": {
      "type": "null"
    },
    "hub-bool": {
      "type": "boolean"
    },
    "hub-oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hub-hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hub-signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "hub-secret": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hub-text": {
      "type": "string",
      "maxLength": 65536
    },
    "hub-path": {
      "type": "string",
      "pattern": "^(/data/|/logs/)[a-zA-Z0-9_./-]{1,512}$|^@step/[0-9]{1,20}$"
    },
    "hub-write-path": {
      "type": "string",
      "pattern": "^/data/[a-zA-Z0-9_./-]{1,512}$"
    },
    "hub-chunk-hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2}){1,32768}$"
    },
    "hub-timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "hub-size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "hub-read-size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "hub-queue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "hub-maybe-oid": {
      "anyOf": [
        {
          "$ref": "#/$defs/hub-oid"
        },
        {
          "$ref": "#/$defs/hub-null"
        }
      ]
    },
    "hub-target": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        {
          "$ref": "#/$defs/hub-null"
        }
      ]
    },
    "hub-maybe-step": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        {
          "$ref": "#/$defs/hub-null"
        }
      ]
    },
    "hub-maybe-error": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "$ref": "#/$defs/hub-null"
        }
      ]
    },
    "hub-maybe-secret": {
      "anyOf": [
        {
          "$ref": "#/$defs/hub-secret"
        },
        {
          "$ref": "#/$defs/hub-null"
        }
      ]
    },
    "hub-empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "hub-state": {
      "enum": [
        "stopped",
        "running",
        "paused",
        "faulted"
      ]
    },
    "hub-ref": {
      "enum": [
        "refs/heads/hub",
        "refs/published/main",
        "refs/heads/logs"
      ]
    },
    "hub-fetch-ref": {
      "enum": [
        "refs/published/main",
        "refs/heads/logs"
      ]
    },
    "hub-method": {
      "enum": [
        "hub.enroll",
        "hub.install",
        "hub.start",
        "hub.stop",
        "hub.status",
        "hub.git.push",
        "hub.git.fetch",
        "hub.events",
        "hub.actions",
        "debug.read",
        "debug.write",
        "debug.pause",
        "debug.step",
        "hub.inbox",
        "hub.health",
        "hub.receipt",
        "hub.cancel"
      ]
    },
    "hub-methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hub-method"
      },
      "maxItems": 17
    },
    "hub-purpose-delegation": {
      "enum": [
        "delegation"
      ]
    },
    "hub-delegation-statement": {
      "type": "object",
      "properties": {
        "purpose": {
          "$ref": "#/$defs/hub-purpose-delegation"
        },
        "coglet": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "device": {
          "$ref": "common.schema.json#/$defs/node-id"
        },
        "hub": {
          "$ref": "common.schema.json#/$defs/node-id"
        },
        "generation": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "expires": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "methods": {
          "$ref": "#/$defs/hub-methods"
        }
      },
      "required": [
        "purpose",
        "coglet",
        "device",
        "hub",
        "generation",
        "expires",
        "methods"
      ],
      "additionalProperties": false
    },
    "hub-ref-purpose": {
      "enum": [
        "hub-ref",
        "published-ref",
        "logs-ref"
      ]
    },
    "hub-ref-statement": {
      "type": "object",
      "properties": {
        "purpose": {
          "$ref": "#/$defs/hub-ref-purpose"
        },
        "hub": {
          "$ref": "common.schema.json#/$defs/node-id"
        },
        "coglet": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "ref": {
          "$ref": "#/$defs/hub-ref"
        },
        "old": {
          "$ref": "#/$defs/hub-maybe-oid"
        },
        "new": {
          "$ref": "#/$defs/hub-oid"
        },
        "archive_sha256": {
          "$ref": "#/$defs/hub-hash"
        },
        "generation": {
          "$ref": "common.schema.json#/$defs/uint64"
        }
      },
      "required": [
        "purpose",
        "hub",
        "coglet",
        "ref",
        "old",
        "new",
        "archive_sha256",
        "generation"
      ],
      "additionalProperties": false
    },
    "hub-signed-delegation": {
      "type": "object",
      "properties": {
        "statement": {
          "$ref": "#/$defs/hub-delegation-statement"
        },
        "signer": {
          "$ref": "common.schema.json#/$defs/node-id"
        },
        "signature": {
          "$ref": "#/$defs/hub-signature"
        }
      },
      "required": [
        "statement",
        "signer",
        "signature"
      ],
      "additionalProperties": false
    },
    "hub-signed-ref": {
      "type": "object",
      "properties": {
        "statement": {
          "$ref": "#/$defs/hub-ref-statement"
        },
        "signer": {
          "$ref": "common.schema.json#/$defs/node-id"
        },
        "signature": {
          "$ref": "#/$defs/hub-signature"
        }
      },
      "required": [
        "statement",
        "signer",
        "signature"
      ],
      "additionalProperties": false
    },
    "hub-status": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/hub-state"
        },
        "live_commit": {
          "$ref": "#/$defs/hub-maybe-oid"
        },
        "step": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "pending": {
          "$ref": "#/$defs/hub-queue"
        },
        "error": {
          "$ref": "#/$defs/hub-maybe-error"
        }
      },
      "required": [
        "state",
        "live_commit",
        "step",
        "pending",
        "error"
      ],
      "additionalProperties": false
    },
    "hub-queued": {
      "enum": [
        "queued"
      ]
    },
    "hub-receipt-queued": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "state": {
          "$ref": "#/$defs/hub-queued"
        },
        "step": {
          "$ref": "#/$defs/hub-null"
        },
        "error": {
          "$ref": "#/$defs/hub-null"
        }
      },
      "required": [
        "operation_id",
        "state",
        "step",
        "error"
      ],
      "additionalProperties": false
    },
    "hub-applied": {
      "enum": [
        "applied"
      ]
    },
    "hub-receipt-applied": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "state": {
          "$ref": "#/$defs/hub-applied"
        },
        "step": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "error": {
          "$ref": "#/$defs/hub-null"
        }
      },
      "required": [
        "operation_id",
        "state",
        "step",
        "error"
      ],
      "additionalProperties": false
    },
    "hub-cancelled": {
      "enum": [
        "cancelled"
      ]
    },
    "hub-receipt-cancelled": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "state": {
          "$ref": "#/$defs/hub-cancelled"
        },
        "step": {
          "$ref": "#/$defs/hub-null"
        },
        "error": {
          "$ref": "#/$defs/hub-null"
        }
      },
      "required": [
        "operation_id",
        "state",
        "step",
        "error"
      ],
      "additionalProperties": false
    },
    "hub-failed": {
      "enum": [
        "failed"
      ]
    },
    "hub-receipt-failed": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "state": {
          "$ref": "#/$defs/hub-failed"
        },
        "step": {
          "$ref": "#/$defs/hub-null"
        },
        "error": {
          "$ref": "common.schema.json#/$defs/error"
        }
      },
      "required": [
        "operation_id",
        "state",
        "step",
        "error"
      ],
      "additionalProperties": false
    },
    "hub-mutation-receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/hub-receipt-queued"
        },
        {
          "$ref": "#/$defs/hub-receipt-applied"
        },
        {
          "$ref": "#/$defs/hub-receipt-cancelled"
        },
        {
          "$ref": "#/$defs/hub-receipt-failed"
        }
      ]
    },
    "hub-inbox-message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "sender": {
          "$ref": "common.schema.json#/$defs/source-id"
        },
        "event": {
          "$ref": "common.schema.json#/$defs/event"
        }
      },
      "required": [
        "id",
        "sender",
        "event"
      ],
      "additionalProperties": false
    },
    "hub-event-batch": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/event"
      },
      "maxItems": 64
    },
    "hub-health-item": {
      "type": "object",
      "properties": {
        "coglet": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "status": {
          "$ref": "#/$defs/hub-status"
        }
      },
      "required": [
        "coglet",
        "status"
      ],
      "additionalProperties": false
    },
    "hub-health-items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hub-health-item"
      },
      "maxItems": 256
    },
    "hub-enroll-params": {
      "type": "object",
      "properties": {
        "offer": {
          "$ref": "common.schema.json#/$defs/version-offer"
        },
        "invite": {
          "$ref": "#/$defs/hub-maybe-secret"
        }
      },
      "required": [
        "offer",
        "invite"
      ],
      "additionalProperties": false
    },
    "hub-install-params": {
      "type": "object",
      "properties": {
        "delegation": {
          "$ref": "#/$defs/hub-signed-delegation"
        },
        "initial": {
          "$ref": "#/$defs/hub-signed-ref"
        }
      },
      "required": [
        "delegation",
        "initial"
      ],
      "additionalProperties": false
    },
    "hub-push-params": {
      "type": "object",
      "properties": {
        "update": {
          "$ref": "#/$defs/hub-signed-ref"
        },
        "size": {
          "$ref": "#/$defs/hub-size"
        },
        "sha256": {
          "$ref": "#/$defs/hub-hash"
        }
      },
      "required": [
        "update",
        "size",
        "sha256"
      ],
      "additionalProperties": false
    },
    "hub-fetch-params": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/hub-fetch-ref"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "hub-events-params": {
      "type": "object",
      "properties": {
        "events": {
          "$ref": "#/$defs/hub-event-batch"
        }
      },
      "required": [
        "events"
      ],
      "additionalProperties": false
    },
    "hub-actions-params": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "common.schema.json#/$defs/action"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "hub-read-params": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/hub-path"
        },
        "offset": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "limit": {
          "$ref": "#/$defs/hub-read-size"
        }
      },
      "required": [
        "path",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    "hub-write-params": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/hub-write-path"
        },
        "text": {
          "$ref": "#/$defs/hub-text"
        },
        "expected_hash": {
          "$ref": "#/$defs/hub-hash"
        },
        "actor": {
          "$ref": "common.schema.json#/$defs/source-id"
        },
        "ticket": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        }
      },
      "required": [
        "path",
        "text",
        "expected_hash",
        "actor"
      ],
      "additionalProperties": false
    },
    "hub-inbox-params": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/hub-inbox-message"
        },
        "actor": {
          "$ref": "common.schema.json#/$defs/source-id"
        },
        "ticket": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        }
      },
      "required": [
        "message",
        "actor"
      ],
      "additionalProperties": false
    },
    "hub-health-params": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "common.schema.json#/$defs/node-id"
        },
        "uptime_ms": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "queue_depth": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "available_bytes": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "coglets": {
          "$ref": "#/$defs/hub-health-items"
        }
      },
      "required": [
        "device",
        "uptime_ms",
        "queue_depth",
        "available_bytes",
        "coglets"
      ],
      "additionalProperties": false
    },
    "hub-operation-params": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        }
      },
      "required": [
        "operation_id"
      ],
      "additionalProperties": false
    },
    "hub-context": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "common.schema.json#/$defs/source-id"
        },
        "ticket": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        }
      },
      "required": [
        "actor"
      ],
      "additionalProperties": false
    },
    "hub-enroll-request-method": {
      "enum": [
        "hub.enroll"
      ]
    },
    "hub-enroll-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-enroll-request-method"
        },
        "target": {
          "$ref": "#/$defs/hub-null"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-enroll-params"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params"
      ],
      "additionalProperties": false
    },
    "hub-install-request-method": {
      "enum": [
        "hub.install"
      ]
    },
    "hub-install-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-install-request-method"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-install-params"
        },
        "context": {
          "$ref": "#/$defs/hub-context"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params",
        "context"
      ],
      "additionalProperties": false
    },
    "hub-start-request-method": {
      "enum": [
        "hub.start"
      ]
    },
    "hub-start-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-start-request-method"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-empty"
        },
        "context": {
          "$ref": "#/$defs/hub-context"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params",
        "context"
      ],
      "additionalProperties": false
    },
    "hub-stop-request-method": {
      "enum": [
        "hub.stop"
      ]
    },
    "hub-stop-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-stop-request-method"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-empty"
        },
        "context": {
          "$ref": "#/$defs/hub-context"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params",
        "context"
      ],
      "additionalProperties": false
    },
    "hub-status-request-method": {
      "enum": [
        "hub.status"
      ]
    },
    "hub-status-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-status-request-method"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-empty"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params"
      ],
      "additionalProperties": false
    },
    "hub-git-push-request-method": {
      "enum": [
        "hub.git.push"
      ]
    },
    "hub-git-push-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-git-push-request-method"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-push-params"
        },
        "context": {
          "$ref": "#/$defs/hub-context"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params",
        "context"
      ],
      "additionalProperties": false
    },
    "hub-git-fetch-request-method": {
      "enum": [
        "hub.git.fetch"
      ]
    },
    "hub-git-fetch-request": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/hub-git-fetch-request-method"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "timeout_ms": {
          "$ref": "#/$defs/hub-timeout"
        },
        "params": {
          "$ref": "#/$defs/hub-fetch-params"
        }
      },
      "required": [
        "method",
        "target",
        "correlation_id",
        "timeout_ms",
        "params"
      ],
      "additionalProperties": false
    },
    "hub-events-request-method": {
      "enum": [
        "hub.events"
      ]
    },
    "hub-events-request": {
      "type": "object",
