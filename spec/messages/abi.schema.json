{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coglet.dev/spec/messages/abi.schema.json",
  "anyOf": [
    {
      "$ref": "#/$defs/trace"
    },
    {
      "$ref": "#/$defs/step-record"
    },
    {
      "$ref": "#/$defs/boundary-record"
    },
    {
      "$ref": "#/$defs/inbox-message"
    },
    {
      "$ref": "#/$defs/timer-request"
    },
    {
      "$ref": "#/$defs/llm-request"
    },
    {
      "$ref": "#/$defs/llm-reply"
    },
    {
      "$ref": "#/$defs/log-entry"
    },
    {
      "$ref": "#/$defs/manifest"
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "pattern": "^/(code|data|logs)(/[^/\\u0000-\\u001f\\u007f\\\\]+)+(?![\\s\\S])"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/hex"
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "compute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "compute_mode": {
          "type": "string",
          "minLength": 1
        },
        "memory_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "wall_time_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "host_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "compute",
        "compute_mode",
        "memory_pages",
        "wall_time_us",
        "max_events",
        "host_bytes"
      ],
      "additionalProperties": false
    },
    "heard-span": {
      "type": "object",
      "properties": {
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "end_ms",
        "text"
      ],
      "additionalProperties": false
    },
    "heard-item": {
      "type": "object",
      "properties": {
        "surface": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/surface-id"
        },
        "item": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "duration_ms": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "played_ms": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "stopped": {
          "type": "boolean"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/heard-span"
          },
          "minItems": 0
        },
        "heard": {
          "type": "string"
        }
      },
      "required": [
        "surface",
        "item",
        "duration_ms",
        "played_ms",
        "stopped",
        "spans",
        "heard"
      ],
      "additionalProperties": false
    },
    "heard-state": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/heard-item"
          },
          "minItems": 0
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "timer-request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "at": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        }
      },
      "required": [
        "id",
        "at"
      ],
      "additionalProperties": false
    },
    "llm-request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "correlation_id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "capability": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/capability-name"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/profile-map"
        }
      },
      "required": [
        "id",
        "correlation_id",
        "capability",
        "model",
        "input"
      ],
      "additionalProperties": false
    },
    "log-entry": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/profile-map"
        }
      },
      "required": [
        "level",
        "message",
        "fields"
      ],
      "additionalProperties": false
    },
    "llm-reply": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "request_id": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            "status": {
              "const": "succeeded"
            },
            "output": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/profile-map"
            }
          },
          "required": [
            "request_id",
            "status",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "request_id": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            "status": {
              "const": "failed"
            },
            "error": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "request_id",
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inbox-message": {
      "type": "object",
      "properties": {
        "index": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "sender": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/source-id"
        },
        "event": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/event"
        }
      },
      "required": [
        "index",
        "id",
        "sender",
        "event"
      ],
      "additionalProperties": false
    },
    "call": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "timer"
            },
            "argument": {
              "$ref": "#/$defs/timer-request"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "emit"
            },
            "argument": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/action"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "llm"
            },
            "argument": {
              "$ref": "#/$defs/llm-request"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "log"
            },
            "argument": {
              "$ref": "#/$defs/log-entry"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "timer",
                "emit",
                "llm",
                "log"
              ]
            },
            "argument_hex": {
              "$ref": "#/$defs/hex"
            },
            "result": {
              "const": 1
            }
          },
          "required": [
            "op",
            "argument_hex",
            "result"
          ],
          "additionalProperties": false
        }
      ]
    },
    "boundary-change": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/source-id"
        },
        "audit_id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "ticket": {
          "anyOf": [
            {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/method-name"
        },
        "target": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/coglet-id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/hex"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor",
        "audit_id",
        "ticket",
        "method",
        "target",
        "path",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "build",
        "policy"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "compute": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "memory_pages": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "wall_time_us": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "host_bytes": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        }
      },
      "required": [
        "compute",
        "memory_pages",
        "wall_time_us",
        "host_bytes"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "compute",
            "memory",
            "wall",
            "host_bytes",
            "trap",
            "guest_return",
            "invalid_argument"
          ]
        },
        "error": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/error"
        }
      },
      "required": [
        "kind",
        "error"
      ],
      "additionalProperties": false
    },
