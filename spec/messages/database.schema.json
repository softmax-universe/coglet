{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coglet.dev/spec/messages/database.schema.json",
  "$ref": "#/$defs/database",
  "$defs": {
    "db-cell": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 18446744073709551615
        },
        {
          "type": "string",
          "minLength": 0
        }
      ]
    },
    "db-cursor": {
      "type": "string",
      "minLength": 1
    },
    "db-statement": {
      "type": "object",
      "properties": {
        "operation": {
          "const": "statement"
        },
        "statement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        },
        "mode": {
          "enum": [
            "read",
            "write"
          ]
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/db-cell"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "cursor": {
          "$ref": "#/$defs/db-cursor"
        }
      },
      "required": [
        "operation",
        "statement",
        "mode",
        "params",
        "max_rows",
        "max_bytes"
      ],
      "additionalProperties": false
    },
    "db-enqueue": {
      "type": "object",
      "properties": {
        "operation": {
          "const": "enqueue"
        },
        "intent_id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/action-id"
        },
        "idempotency_key": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        },
        "kind": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/capability-name"
        },
        "payload": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/profile-map"
        },
        "correlation_id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
        }
      },
      "required": [
        "operation",
        "intent_id",
        "idempotency_key",
        "kind",
        "payload",
        "correlation_id"
      ],
      "additionalProperties": false
    },
    "db-request": {
      "anyOf": [
        {
          "$ref": "#/$defs/db-statement"
        },
        {
          "$ref": "#/$defs/db-enqueue"
        }
      ]
    },
    "db-page": {
      "type": "object",
      "properties": {
        "status": {
          "const": "page"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 16
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/db-cell"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "minItems": 0,
          "maxItems": 64
        },
        "affected": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "revision": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/db-cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "columns",
        "rows",
        "affected",
        "revision",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "db-enqueued": {
      "type": "object",
      "properties": {
        "status": {
          "const": "enqueued"
        },
        "intent_id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/action-id"
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "intent_id",
        "duplicate"
      ],
      "additionalProperties": false
    },
    "db-failed": {
      "type": "object",
      "properties": {
        "status": {
          "const": "failed"
        },
        "error": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/error"
        }
      },
      "required": [
        "status",
        "error"
      ],
      "additionalProperties": false
    },
    "db-reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/db-page"
        },
        {
          "$ref": "#/$defs/db-enqueued"
        },
        {
          "$ref": "#/$defs/db-failed"
        }
      ]
    },
    "db-outcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "intent_id": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/action-id"
            },
            "idempotency_key": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            "correlation_id": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            "status": {
              "const": "succeeded"
            },
            "result": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/profile-map"
            }
          },
          "required": [
            "intent_id",
            "idempotency_key",
            "correlation_id",
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "intent_id": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/action-id"
            },
            "idempotency_key": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            "correlation_id": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/correlation-id"
            },
            "status": {
              "enum": [
                "failed",
                "cancelled"
              ]
            },
            "error": {
              "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "intent_id",
            "idempotency_key",
            "correlation_id",
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "db-host-call": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "db"
            },
            "argument": {
              "$ref": "#/$defs/db-request"
            },
            "result": {
              "const": 0
            },
            "response": {
              "$ref": "#/$defs/db-reply"
            }
          },
          "required": [
            "op",
            "argument",
            "result",
            "response"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "db"
            },
            "argument": {
              "$ref": "#/$defs/db-request"
            },
            "result": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "db"
            },
            "argument_hex": {
              "$ref": "https://coglet.dev/spec/messages/abi.schema.json#/$defs/hex"
            },
            "result": {
              "const": 1
            }
          },
          "required": [
            "op",
            "argument_hex",
            "result"
          ],
          "additionalProperties": false
        }
      ]
    },
    "db-config": {
      "type": "object",
      "properties": {
        "schema_min": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "schema_max": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/uint64"
        },
        "catalog_hash": {
          "$ref": "https://coglet.dev/spec/messages/abi.schema.json#/$defs/hash"
        }
      },
      "required": [
        "schema_min",
        "schema_max",
        "catalog_hash"
      ],
      "additionalProperties": false
    },
    "db-manifest": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.2"
        },
        "id": {
          "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/coglet-id"
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/capability-name"
          },
          "minItems": 0
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/capability-name"
          },
          "minItems": 0
        },
        "exclusive_outputs": {
          "type": "array",
          "items": {
            "$ref": "https://coglet.dev/spec/messages/common.schema.json#/$defs/capability-name"
          },
          "minItems": 0
        },
        "budgets": {
          "$ref": "https://coglet.dev/spec/messages/abi.schema.json#/$defs/budgets"
        },
        "database": {
          "$ref": "#/$defs/db-config"
        }
      },
      "required": [
        "version",
        "id",
        "subscriptions",
        "required_capabilities",
        "exclusive_outputs",
        "budgets",
        "database"
      ],
      "additionalProperties": false
    },
