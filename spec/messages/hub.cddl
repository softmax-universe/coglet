; Generated by hub/generate.py; import common.cddl unchanged.
wire = hub-frame
hub-null = null
hub-bool = bool
hub-hash = tstr .regexp "^[0-9a-f]{64}$"
hub-build-version = "1.0"
hub-build-record = {"version": hub-build-version, "source_tree": hub-hash, "recipe_sha256": hub-hash, "policy_sha256": hub-hash, "transform_sha256": hub-hash, "original_sha256": hub-hash, "rewritten_sha256": hub-hash}
hub-signature = tstr .regexp "^[0-9a-f]{128}$"
hub-secret = tstr .regexp "^[0-9a-f]{64}$"
hub-text = tstr .size (0..65536)
hub-path = tstr .regexp "^(/data/|/logs/)[a-zA-Z0-9_./-]{1,512}$|^@step/[0-9]{1,20}$"
hub-write-path = tstr .regexp "^/data/[a-zA-Z0-9_./-]{1,512}$"
hub-chunk-hex = tstr .regexp "^([0-9a-f]{2}){1,32768}$"
hub-timeout = 1..300000
hub-size = 1..67108864
hub-read-size = 1..65536
hub-queue = 0..256
hub-maybe-tree = hub-hash / hub-null
hub-maybe-generation = uint64 / hub-null
hub-target = coglet-id / hub-null
hub-maybe-step = uint64 / hub-null
hub-maybe-error = error / hub-null
hub-maybe-secret = hub-secret / hub-null
hub-empty = {*0 tstr => profile-value}
hub-state = "stopped" / "running" / "paused" / "faulted"
hub-method = "hub.enroll" / "hub.install" / "hub.start" / "hub.stop" / "hub.status" / "manage.patch" / "manage.tail_log" / "hub.events" / "hub.actions" / "manage.read" / "manage.write" / "manage.pause" / "manage.step" / "hub.inbox" / "hub.health" / "hub.receipt" / "hub.cancel"
hub-methods = [*17 hub-method]
hub-purpose-delegation = "delegation"
hub-delegation-statement = {"purpose": hub-purpose-delegation, "coglet": coglet-id, "device": node-id, "hub": node-id, "generation": uint64, "expires": uint64, "methods": hub-methods}
hub-signed-delegation = {"statement": hub-delegation-statement, "signer": node-id, "signature": hub-signature}
manage-file-bytes = tstr .regexp "^([0-9a-f]{2})*$"
manage-code-path = tstr .regexp "^[a-zA-Z0-9_.-]+(/[a-zA-Z0-9_.-]+)*$"
manage-file-change = {"path": manage-code-path, ? "bytes": manage-file-bytes}
manage-files = [*4096 manage-file-change]
manage-patch = {? "base": hub-hash, "revision": hub-hash, "generation": uint64, "files": manage-files, "signature": hub-signature}
manage-patch-signing = {"hub": node-id, "coglet": coglet-id, ? "base": hub-hash, "revision": hub-hash, "generation": uint64, "files": manage-files}
hub-status = {"state": hub-state, "live_tree": hub-maybe-tree, "generation": hub-maybe-generation, "step": uint64, "pending": hub-queue, "error": hub-maybe-error}
hub-queued = "queued"
hub-receipt-queued = {"operation_id": correlation-id, "state": hub-queued, "step": hub-null, "error": hub-null}
hub-applied = "applied"
hub-receipt-applied = {"operation_id": correlation-id, "state": hub-applied, "step": uint64, "error": hub-null}
hub-cancelled = "cancelled"
hub-receipt-cancelled = {"operation_id": correlation-id, "state": hub-cancelled, "step": hub-null, "error": hub-null}
hub-failed = "failed"
hub-receipt-failed = {"operation_id": correlation-id, "state": hub-failed, "step": hub-null, "error": error}
hub-mutation-receipt = hub-receipt-queued / hub-receipt-applied / hub-receipt-cancelled / hub-receipt-failed
hub-inbox-delivery = {"id": correlation-id, "sender": source-id, "event": event}
hub-event-batch = [*64 event]
hub-health-item = {"coglet": coglet-id, "status": hub-status}
hub-health-items = [*256 hub-health-item]
hub-enroll-params = {"offer": version-offer, "invite": hub-maybe-secret}
hub-install-params = {"delegation": hub-signed-delegation, "initial": hub-hash}
manage-patch-params = {"size": hub-size, "sha256": hub-hash}
manage-tail-log-params = {"from_offset": uint64}
hub-events-params = {"offset": uint64, "events": hub-event-batch}
hub-actions-params = {"action": action}
hub-read-params = {"path": hub-path, "offset": uint64, "limit": hub-read-size}
hub-write-params = {"path": hub-write-path, "text": hub-text, "expected_hash": hub-hash, "actor": source-id, ? "ticket": correlation-id}
hub-inbox-params = {"message": hub-inbox-delivery, "actor": source-id, ? "ticket": correlation-id}
hub-health-params = {"device": node-id, "uptime_ms": uint64, "queue_depth": uint64, "available_bytes": uint64, "coglets": hub-health-items}
hub-operation-params = {"operation_id": correlation-id}
hub-context = {"actor": source-id, ? "ticket": correlation-id}
hub-enroll-request-method = "hub.enroll"
hub-enroll-request = {"method": hub-enroll-request-method, "target": hub-null, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-enroll-params}
hub-install-request-method = "hub.install"
hub-install-request = {"method": hub-install-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-install-params, "context": hub-context}
hub-start-request-method = "hub.start"
hub-start-request = {"method": hub-start-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-empty, "context": hub-context}
hub-stop-request-method = "hub.stop"
hub-stop-request = {"method": hub-stop-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-empty, "context": hub-context}
hub-status-request-method = "hub.status"
hub-status-request = {"method": hub-status-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-empty, "context": hub-context}
manage-patch-request-method = "manage.patch"
manage-patch-request = {"method": manage-patch-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": manage-patch-params, "context": hub-context}
manage-tail_log-request-method = "manage.tail_log"
manage-tail_log-request = {"method": manage-tail_log-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": manage-tail-log-params, "context": hub-context}
hub-events-request-method = "hub.events"
hub-events-request = {"method": hub-events-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-events-params}
hub-actions-request-method = "hub.actions"
hub-actions-request = {"method": hub-actions-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-actions-params, "context": hub-context}
manage-read-request-method = "manage.read"
manage-read-request = {"method": manage-read-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-read-params, "context": hub-context}
manage-write-request-method = "manage.write"
manage-write-request = {"method": manage-write-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-write-params}
manage-pause-request-method = "manage.pause"
manage-pause-request = {"method": manage-pause-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-empty, "context": hub-context}
manage-step-request-method = "manage.step"
manage-step-request = {"method": manage-step-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-empty, "context": hub-context}
hub-inbox-request-method = "hub.inbox"
hub-inbox-request = {"method": hub-inbox-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-inbox-params}
hub-health-request-method = "hub.health"
hub-health-request = {"method": hub-health-request-method, "target": hub-null, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-health-params}
hub-receipt-request-method = "hub.receipt"
hub-receipt-request = {"method": hub-receipt-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-operation-params, "context": hub-context}
hub-cancel-request-method = "hub.cancel"
hub-cancel-request = {"method": hub-cancel-request-method, "target": coglet-id, "correlation_id": correlation-id, "timeout_ms": hub-timeout, "params": hub-operation-params, "context": hub-context}
hub-request = hub-enroll-request / hub-install-request / hub-start-request / hub-stop-request / hub-status-request / manage-patch-request / manage-tail_log-request / hub-events-request / hub-actions-request / manage-read-request / manage-write-request / manage-pause-request / manage-step-request / hub-inbox-request / hub-health-request / hub-receipt-request / hub-cancel-request
hub-enroll-result = {"selection": version-selection, "device": node-id, "hub": node-id}
hub-read-result = {"step": uint64, "snapshot_hash": hub-hash, "text": hub-text, "next_offset": uint64, "eof": hub-bool}
hub-events-result = {"next_offset": uint64}
hub-step-result = {"receipt": hub-mutation-receipt, "step": uint64}
hub-result = hub-enroll-result / hub-mutation-receipt / hub-status / action-accept / hub-read-result / hub-events-result / hub-step-result / hub-empty
hub-success-type = "reply"
hub-success = {"type": hub-success-type, "correlation_id": correlation-id, "result": hub-result}
hub-failure-type = "error"
hub-failure = {"type": hub-failure-type, "correlation_id": correlation-id, "error": error}
hub-credit-type = "credit"
hub-credit = {"type": hub-credit-type, "correlation_id": correlation-id, "bytes": uint64}
hub-chunk-type = "chunk"
hub-chunk = {"type": hub-chunk-type, "correlation_id": correlation-id, "offset": uint64, "hex": hub-chunk-hex}
hub-end-type = "end"
hub-end = {"type": hub-end-type, "correlation_id": correlation-id}
manage-log-path = tstr .regexp "^/logs/[a-zA-Z0-9_./-]{1,512}$"
manage-log-entry = {"path": manage-log-path, "file_offset": uint64, "hex": hub-chunk-hex}
manage-tail-log-result = {"next_offset": uint64}
manage-log-type = "log"
manage-log = {"type": manage-log-type, "correlation_id": correlation-id, "offset": uint64, "hex": hub-chunk-hex}
hub-frame = hub-request / hub-success / hub-failure / hub-credit / hub-chunk / hub-end / manage-log
