; Kernel promotion — DRAFT 0.1 (M3 freeze, not v0).
; Import common.cddl by concatenation once, after the selected entry rule.
; Closed shapes only; binding, trust and temporal rules are in promotion.md.
promotion = promotion-propose / promotion-promote / promotion-rollback /
  promotion-status-request / promotion-response / promotion-audit
promotion-commit = tstr .regexp "^([0-9a-f]{40}|[0-9a-f]{64})$"
promotion-text = tstr .size (1..18446744073709551615)
promotion-op = "propose" / "promote" / "rollback" / "status"
; Explicit absent-key constraints preserve closed choices in pycddl 0.6.4:
; a failed sibling must not consume a key for the successful alternative.
; The second intersection also rejects arrays retained by a failed sibling.
promotion-never = (nil .and false) .and []
promotion-no-audit = (
  ? audit_id: promotion-never, ? actor: promotion-never,
  ? operation: promotion-never, ? phase: promotion-never,
  ? generation: promotion-never, ? observed_at_ms: promotion-never,
  ? before_commit: promotion-never, ? after_commit: promotion-never,
  ? evidence_refs: promotion-never
)
promotion-no-response = (
  ? ok: promotion-never, ? result: promotion-never, ? error: promotion-never
)
promotion-no-propose = (
  ? candidate: promotion-never, ? base: promotion-never,
  ? policy_revision: promotion-never, ? gates: promotion-never,
  ? approval_ref: promotion-never
)
promotion-response-closure = (
  promotion-no-audit, promotion-no-propose,
  ? proposal_id: promotion-never, ? expected_generation: promotion-never,
  ? reason: promotion-never
)
promotion-envelope = (
  version: "0.1", correlation_id: correlation-id, coglet: coglet-id
)
promotion-gate-report = {
  kind: "journal_replay" / "headless_game", suite: promotion-text,
  candidate: promotion-commit, base: promotion-commit / null,
  policy_revision: correlation-id, checked_at_ms: uint64,
  status: "passed" / "failed", evidence_ref: promotion-text,
  * tstr => nil .and false
}
promotion-propose = {
  promotion-envelope, op: "propose", candidate: promotion-commit,
  base: promotion-commit / null, expected_generation: uint64,
  policy_revision: correlation-id, gates: [+ promotion-gate-report],
  ? approval_ref: promotion-text, promotion-no-audit, promotion-no-response,
  ? proposal_id: promotion-never, ? reason: promotion-never
}
promotion-promote = {
  promotion-envelope, op: "promote", proposal_id: correlation-id,
  expected_generation: uint64, promotion-no-audit, promotion-no-response,
  promotion-no-propose, ? reason: promotion-never
}
promotion-rollback = {
  promotion-envelope, op: "rollback", expected_generation: uint64,
  reason: promotion-text, promotion-no-audit, promotion-no-response,
  promotion-no-propose, ? proposal_id: promotion-never
}
promotion-status-request = {
  promotion-envelope, op: "status", promotion-response-closure,
  promotion-no-response
}
promotion-status = {
  generation: uint64, live_commit: promotion-commit / null,
  last_known_good: promotion-commit / null, candidate: promotion-commit / null,
  state: "empty" / "proposed" / "activating" / "probation" / "stable" /
    "rolling_back" / "stopped",
  proposal_id: correlation-id / null, policy_revision: correlation-id,
  probation: promotion-probation / null, recent_health: [0*64 promotion-health]
}
promotion-probation = {
  started_at_ms: uint64, expires_at_ms: uint64, consecutive_failures: uint64,
  step_failures: uint64, budget_violations: uint64
}
promotion-health = {
  generation: uint64, commit: promotion-commit, observed_at_ms: uint64, healthy: bool,
  * tstr => nil .and false
}
promotion-response = {
  promotion-envelope, op: "propose", ok: true,
  result: {proposal_id: correlation-id, state: "proposed"},
  promotion-response-closure, ? error: promotion-never
} / {
  promotion-envelope, op: "promote", ok: true,
  result: {proposal_id: correlation-id, state: "activating"},
  promotion-response-closure, ? error: promotion-never
} / {
  promotion-envelope, op: "rollback", ok: true, result: {state: "rolling_back"},
  promotion-response-closure, ? error: promotion-never
} / {
  promotion-envelope, op: "status", ok: true, result: promotion-status,
  promotion-response-closure, ? error: promotion-never
} / {
  promotion-envelope, op: promotion-op, ok: false, error: error,
  promotion-response-closure, ? result: promotion-never
}
promotion-audit = {
  version: "0.1", audit_id: correlation-id, correlation_id: correlation-id,
  coglet: coglet-id, actor: "kernel" / coglet-id / hub-id / surface-id,
  operation: promotion-op,
  phase: "admitted" / "rejected" / "activated" / "probation_passed" /
    "rollback_triggered" / "restored" / "stopped" / "observed",
  generation: uint64, observed_at_ms: uint64, proposal_id: correlation-id / null,
  before_commit: promotion-commit / null, after_commit: promotion-commit / null,
  policy_revision: correlation-id, reason: promotion-text,
  evidence_refs: [* promotion-text], promotion-no-response,
  ? op: promotion-never, ? candidate: promotion-never, ? base: promotion-never,
  ? expected_generation: promotion-never, ? gates: promotion-never,
  ? approval_ref: promotion-never
}
