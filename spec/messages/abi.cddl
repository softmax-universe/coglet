; Import common.cddl after this file. Shapes only; semantic invariants are in abi.md.
abi = trace / step-record / boundary-record / inbox-message / timer-request / llm-request / llm-reply / log-entry / manifest
; Filesystem state hashes: Git SHA-256 tree ids, 100644 blobs, 40000 trees, Git ordering (ADR-0035).
; Snapshot CBOR is the wire representation, not the filesystem hash input.
hash = tstr .regexp "^[0-9a-f]{64}$"
hex = tstr .regexp "^([0-9a-f]{2})*$"
path = tstr .regexp "^/(code|data|logs)(/[^/\\x00-\\x1f\\x7f\\\\]+)+$"
snapshot = {* tstr => hex}
budgets = {"compute": 1..18446744073709551615, "compute_mode": tstr .size (1..18446744073709551615), "memory_pages": 1..65536, "wall_time_us": 1..18446744073709551615, "max_events": 1..18446744073709551615, "host_bytes": 1..18446744073709551615}
heard-span = {"end_ms": 1..18446744073709551615, "text": tstr}
heard-item = {"surface": surface-id, "item": correlation-id, "duration_ms": uint64, "played_ms": uint64, "stopped": bool, "spans": [* heard-span], "heard": tstr}
heard-state = {"items": [* heard-item]}
timer-request = {"id": correlation-id, "at": uint64}
llm-request = {"id": correlation-id, "correlation_id": correlation-id, "capability": capability-name, "model": tstr .size (1..18446744073709551615), "input": profile-map}
log-entry = {"level": "debug" / "info" / "warn" / "error", "message": tstr .size (1..18446744073709551615), "fields": profile-map}
llm-reply = {request_id: correlation-id, status: "succeeded", output: profile-map} / {request_id: correlation-id, status: "failed", error: error}
inbox-message = {"index": uint64, "id": correlation-id, "sender": source-id, "event": event}
call = { (op: "timer", argument: timer-request, result: 0..4) // (op: "emit", argument: action, result: 0..4) // (op: "llm", argument: llm-request, result: 0..4) // (op: "log", argument: log-entry, result: 0..4) // (op: "timer" / "emit" / "llm" / "log", argument_hex: hex, result: 1) }
boundary-change = {"actor": source-id, "audit_id": correlation-id, "ticket": correlation-id / null, "method": method-name, "target": coglet-id, "path": path, "before": hex / null, "after": hex / null}
engine = {"build": tstr .size (1..18446744073709551615), "policy": tstr .size (1..18446744073709551615)}
usage = {"compute": uint64, "memory_pages": uint64, "wall_time_us": uint64, "host_bytes": uint64}
failure = {"kind": "compute" / "memory" / "wall" / "host_bytes" / "trap" / "guest_return" / "invalid_argument", "error": error}
step-record = {version: "0.1", trace_id: correlation-id, coglet: coglet-id, step: uint64, logical_time: uint64, seed: uint64, previous: hash / null, code_hash: hash, manifest_hash: hash, before_hash: hash, input_hash: hash, output_hash: hash, record_hash: hash, engine: engine, budgets: budgets, grants: [* capability-name], events: [+ event], boundary: [* boundary-change], calls: [* call], actions: [* action], timers: [* timer-request], llm_requests: [* llm-request], logs: [* log-entry], input_files: snapshot, output_files: snapshot, usage: usage, status: "committed"} / {version: "0.1", trace_id: correlation-id, coglet: coglet-id, step: uint64, logical_time: uint64, seed: uint64, previous: hash / null, code_hash: hash, manifest_hash: hash, before_hash: hash, input_hash: hash, output_hash: hash, record_hash: hash, engine: engine, budgets: budgets, grants: [* capability-name], events: [+ event], boundary: [* boundary-change], calls: [* call], actions: [* action], timers: [* timer-request], llm_requests: [* llm-request], logs: [* log-entry], input_files: snapshot, output_files: snapshot, usage: usage, status: "aborted", failure: failure}
effect-ledger = {"actions": [* correlation-id], "timers": [* correlation-id], "llm_requests": [* correlation-id]}
boundary-record = {"version": "0.1", "trace_id": correlation-id, "coglet": coglet-id, "logical_time": uint64, "previous": hash / null, "before_hash": hash, "output_hash": hash, "record_hash": hash, "boundary": [+ boundary-change], "output_files": snapshot}
action-rejection = action-accept .and ({id: action-id, correlation_id: correlation-id, accepted: false, error: error})
trace = {"version": "0.1", "trace_id": correlation-id, "coglet": coglet-id, "initial_effect_ids": effect-ledger, "initial_actions": [* action], "initial_inbox_wakes": [* uint64], "initial_hash": hash, "initial_files": snapshot, "code_hash": hash, "manifest_hash": hash, "final_hash": hash, "trailing_boundary": boundary-record / null, "initial_timers": [* timer-request], "initial_llm_requests": [* llm-request], "records": [* step-record], "blobs": {* tstr => hex}}
manifest = {version: "0.1", id: coglet-id, subscriptions: [* capability-name], required_capabilities: [* capability-name], exclusive_outputs: [* capability-name], budgets: budgets}
