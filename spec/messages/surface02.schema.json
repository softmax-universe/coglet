            "llm_requests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/s02-llm-request"
              },
              "minItems": 0
            },
            "logs": {
              "type": "array",
              "items": {
                "$ref": "abi.schema.json#/$defs/log-entry"
              },
              "minItems": 0
            },
            "input_files": {
              "$ref": "abi.schema.json#/$defs/snapshot"
            },
            "output_files": {
              "$ref": "abi.schema.json#/$defs/snapshot"
            },
            "usage": {
              "$ref": "abi.schema.json#/$defs/usage"
            },
            "status": {
              "const": "committed"
            }
