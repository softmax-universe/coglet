            "version",
            "trace_id",
            "coglet",
            "step",
            "logical_time",
            "seed",
            "previous",
            "code_hash",
            "manifest_hash",
            "before_hash",
            "input_hash",
            "output_hash",
            "record_hash",
            "engine",
            "budgets",
            "grants",
            "events",
            "boundary",
            "calls",
            "actions",
            "timers",
            "llm_requests",
            "logs",
            "input_files",
            "output_files",
            "usage",
            "status"
          ],
