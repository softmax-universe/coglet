{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coglet.dev/spec/messages/surface02.schema.json",
  "title": "Explicitly provisioned surface-0.2 contracts",
  "anyOf": [
    {
      "$ref": "#/$defs/s02-surface-message"
    },
    {
      "$ref": "#/$defs/s02-event"
    },
    {
      "$ref": "#/$defs/s02-action"
    },
    {
      "$ref": "#/$defs/s02-manifest"
    },
    {
      "$ref": "#/$defs/s02-db-manifest"
    },
    {
      "$ref": "#/$defs/s02-trace"
    },
    {
      "$ref": "#/$defs/s02-db-trace"
    }
  ],
  "$defs": {
    "s02-call": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "timer"
            },
            "argument": {
              "$ref": "abi.schema.json#/$defs/timer-request"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "emit"
            },
            "argument": {
              "$ref": "#/$defs/s02-action"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "llm"
            },
            "argument": {
              "$ref": "#/$defs/s02-llm-request"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "log"
            },
            "argument": {
              "$ref": "abi.schema.json#/$defs/log-entry"
            },
            "result": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "op",
            "argument",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "timer",
                "emit",
                "llm",
                "log"
              ]
            },
            "argument_hex": {
              "$ref": "abi.schema.json#/$defs/hex"
            },
            "result": {
              "const": 1
            }
          },
          "required": [
            "op",
            "argument_hex",
            "result"
          ],
          "additionalProperties": false
        }
      ]
    },
    "s02-inbox-message": {
      "type": "object",
      "properties": {
        "index": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "sender": {
          "$ref": "common.schema.json#/$defs/source-id"
        },
        "event": {
          "$ref": "#/$defs/s02-event"
        }
      },
      "required": [
        "index",
        "id",
        "sender",
        "event"
      ],
      "additionalProperties": false
    },
    "s02-llm-request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "capability": {
          "$ref": "#/$defs/s02-capability-name"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "common.schema.json#/$defs/profile-map"
        }
      },
      "required": [
        "id",
        "correlation_id",
        "capability",
        "model",
        "input"
      ],
      "additionalProperties": false
    },
    "s02-manifest": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/s02-capability-name"
          },
          "minItems": 0
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/s02-capability-name"
          },
          "minItems": 0
        },
        "exclusive_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/s02-capability-name"
          },
          "minItems": 0
        },
        "budgets": {
          "$ref": "abi.schema.json#/$defs/budgets"
        }
      },
      "required": [
        "version",
        "id",
        "subscriptions",
        "required_capabilities",
        "exclusive_outputs",
        "budgets"
      ],
      "additionalProperties": false
    },
