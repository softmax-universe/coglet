        "deadline": {
          "$ref": "common.schema.json#/$defs/uint64"
        },
        "correlation_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        }
      },
      "required": [
        "id",
        "coglet",
        "capability",
        "args",
        "deadline",
        "correlation_id"
      ],
      "additionalProperties": false
    },
    "s02-capability-name": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}|softmax\\.app\\.[a-z][a-z0-9_]{0,31})(?![\\s\\S])"
