    "s02-trace": {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1"
        },
        "trace_id": {
          "$ref": "common.schema.json#/$defs/correlation-id"
        },
        "coglet": {
          "$ref": "common.schema.json#/$defs/coglet-id"
        },
