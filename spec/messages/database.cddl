; ABI 0.2 extension; import common.cddl and abi.cddl unchanged.
; Extended manifest/step/trace shapes are generated by build_database.py below.
database = db-request / db-reply / db-outcome / db-host-call / db-manifest / db-step-record / db-trace / db-boundary-record
; Encoded UTF-8/whole-message byte caps are semantic, not character-count bounds.
db-cell = null / (-9223372036854775808..-1) / uint64 / tstr
db-cursor = tstr .size (1..18446744073709551615)
db-statement = {"operation": "statement", "statement": tstr .regexp "^[a-z][a-z0-9_]{0,63}$", "mode": "read" / "write", "params": [*32 db-cell], "max_rows": 1..64, "max_bytes": 256..65536, ? "cursor": db-cursor}
db-enqueue = {"operation": "enqueue", "intent_id": action-id, "idempotency_key": correlation-id, "kind": capability-name, "payload": profile-map, "correlation_id": correlation-id}
db-request = db-statement / db-enqueue
db-row = [*16 db-cell]
db-page = {"status": "page", "columns": [*16 tstr .size (1..18446744073709551615)], "rows": [*64 db-row], "affected": uint64, "revision": uint64, "next_cursor": db-cursor / null}
db-enqueued = {"status": "enqueued", "intent_id": action-id, "duplicate": bool}
db-failed = {"status": "failed", "error": error}
db-reply = db-page / db-enqueued / db-failed
db-outcome = { ("intent_id": action-id, "idempotency_key": correlation-id, "correlation_id": correlation-id, "status": "succeeded", "result": profile-map) // ("intent_id": action-id, "idempotency_key": correlation-id, "correlation_id": correlation-id, "status": "failed" / "cancelled", "error": error) }
db-host-call = { ("op": "db", "argument": db-request, "result": 0, "response": db-reply) // ("op": "db", "argument": db-request, "result": 1..4) // ("op": "db", "argument_hex": hex, "result": 1) }
db-config = {"schema_min": uint64, "schema_max": uint64, "catalog_hash": hash}
; BEGIN generated ABI extension shapes
db-manifest = {version: "0.2", id: coglet-id, subscriptions: [* capability-name], required_capabilities: [* capability-name], exclusive_outputs: [* capability-name], budgets: budgets, database: db-config}
db-step-record = {version: "0.2", trace_id: correlation-id, coglet: coglet-id, step: uint64, logical_time: uint64, seed: uint64, previous: hash / null, code_hash: hash, manifest_hash: hash, before_hash: hash, input_hash: hash, output_hash: hash, record_hash: hash, db_before: uint64, db_after: uint64, db_schema_version: uint64, db_catalog_hash: hash, engine: engine, budgets: budgets, grants: [* capability-name], events: [+ event], boundary: [* boundary-change], calls: [* (call / db-host-call)], actions: [* action], timers: [* timer-request], llm_requests: [* llm-request], logs: [* log-entry], input_files: snapshot, output_files: snapshot, usage: usage, status: "committed"} / {version: "0.2", trace_id: correlation-id, coglet: coglet-id, step: uint64, logical_time: uint64, seed: uint64, previous: hash / null, code_hash: hash, manifest_hash: hash, before_hash: hash, input_hash: hash, output_hash: hash, record_hash: hash, db_before: uint64, db_after: uint64, db_schema_version: uint64, db_catalog_hash: hash, engine: engine, budgets: budgets, grants: [* capability-name], events: [+ event], boundary: [* boundary-change], calls: [* (call / db-host-call)], actions: [* action], timers: [* timer-request], llm_requests: [* llm-request], logs: [* log-entry], input_files: snapshot, output_files: snapshot, usage: usage, status: "aborted", failure: failure}
db-trace = {"version": "0.2", "trace_id": correlation-id, "coglet": coglet-id, "initial_effect_ids": effect-ledger, "initial_actions": [* action], "initial_inbox_wakes": [* uint64], "initial_hash": hash, "initial_files": snapshot, "code_hash": hash, "manifest_hash": hash, "final_hash": hash, "trailing_boundary": db-boundary-record / null, "initial_timers": [* timer-request], "initial_llm_requests": [* llm-request], "records": [* db-step-record], "blobs": {* tstr => hex}, "initial_db_revision": uint64, "final_db_revision": uint64}
db-boundary-record = {"version": "0.2", "trace_id": correlation-id, "coglet": coglet-id, "logical_time": uint64, "previous": hash / null, "before_hash": hash, "output_hash": hash, "record_hash": hash, "boundary": [+ boundary-change], "output_files": snapshot}
