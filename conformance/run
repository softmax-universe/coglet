#!/usr/bin/env python3
"""Bootstrap entrypoint; registered commands will run the future wire suites."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--registry', type=Path, default=ROOT / 'conformance/implementations.json')
    args = parser.parse_args()
    try:
        implementations = json.loads(args.registry.read_text())
        if not isinstance(implementations, dict):
            raise ValueError('registry must be an object mapping names to command arrays')
        for name, command in implementations.items():
            if not name or not isinstance(command, list) or not command or not all(
                isinstance(arg, str) and arg for arg in command
            ):
                raise ValueError(f'invalid command for {name!r}')
        if not implementations:
            print('No implementations registered; no conformance claims made.')
        for name, command in implementations.items():
            print(f'Running {name}', flush=True)
            subprocess.run(command, cwd=ROOT, check=True, timeout=300)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'conformance: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
