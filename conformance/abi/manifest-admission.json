  {
    "name": "manifest-operation-and-independent-resource",
    "steps": [
      {
        "send": {
          "operation": "abi.manifest_admit",
          "manifest": {
            "version": "1.0",
            "id": "coglet:1111111111111111111111111111111111111111111111111111111111111111",
            "subscriptions": [],
            "required_capabilities": [
              "speech.speak_chunk"
            ],
            "exclusive_outputs": [
              "audio.speaker"
            ],
            "budgets": {
              "compute": 10000,
              "compute_mode": "fixture.interpreter",
              "memory_pages": 2,
              "wall_time_us": 100000,
              "max_events": 16,
              "host_bytes": 65536
            }
          },
          "catalog": [
            {
              "name": "speech.output",
              "events": [],
              "reads": [],
              "actions": [
                "speech.speak_chunk"
              ],
              "exclusive": [
                "audio.speaker"
              ]
            }
          ],
          "grant": {
            "coglet": "coglet:1111111111111111111111111111111111111111111111111111111111111111",
            "operations": [
              "speech.speak_chunk"
            ],
            "resources": [
              "audio.speaker"
            ]
          }
        }
      },
      {
        "expect": {
          "admitted": true,
          "reason": null,
          "instantiated": false
        },
        "within_ms": 200
      }
    ]
  },
