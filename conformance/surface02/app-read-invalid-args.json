{
  "name": "app-read-invalid-args",
  "description": "catalog input schema rejects before execution",
  "contract_profile": "surface-0.2",
  "peer_role": "runtime",
  "fixtures": [
    "surface02-base"
  ],
  "steps": [
    {
      "expect": {
        "type": "hello",
        "body": {
          "surface": "surface:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "offer": {
            "versions": [
              "0.2",
              "0.1"
            ]
          },
          "clock": 0,
          "correlation_id": "11111111111111111111111111111111"
        }
      },
      "within_ms": 200
    },
    {
      "send": {
        "type": "hello_reply",
        "body": {
          "selection": {
            "version": "0.2"
          },
          "correlation_id": "11111111111111111111111111111111"
        }
      }
    },
    {
      "match": {
        "type": "capabilities",
        "body.revision": 1
      },
      "within_ms": 200
    },
    {
      "match": {
        "type": "grants",
        "body.epoch": 1
      },
      "within_ms": 200
    },
    {
      "send": {
        "type": "read",
        "body": {
          "coglet": "coglet:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "capability": "softmax.app.state",
          "args": {},
          "grant_epoch": 1,
          "deadline": 1000000,
          "correlation_id": "11111111111111111111111111111111"
        }
      }
    },
    {
      "match": {
        "type": "read_reply",
        "body.correlation_id": "11111111111111111111111111111111",
        "body.ok": false,
        "body.error.code": "invalid_argument"
      },
      "within_ms": 200
    }
  ]
}
